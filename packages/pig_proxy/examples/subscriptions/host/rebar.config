{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{opentelemetry, "1.7.0"},
        {opentelemetry_api, "1.5.0"},
        {opentelemetry_exporter, "1.10.0"},
        {gproc, "1.3.0"}]}.
%% Official gproc 1.3.0 only hoists exported bindings and replaces lists:zf
%% with equivalent filtermap. Keep grpcbox 0.18.0 and its other dependencies.
{overrides, [{override, grpcbox,
              [{deps, [{acceptor_pool, "1.0.1"},
                       {ctx, "0.6.0"},
                       {gproc, "1.3.0"},
                       {chatterbox, "0.16.0", {pkg, ts_chatterbox}}]}]}]}.
