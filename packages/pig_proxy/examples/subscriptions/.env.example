# Exact upstream IDs; comma-separated when enabling multiple models.
PIG_CHATGPT_MODELS=YOUR_CHATGPT_MODEL_ID
PIG_ZAI_MODELS=YOUR_ZAI_MODEL_ID
ZAI_API_KEY=replace-with-your-zai-key

# Recommended: `docker compose run --rm subscriptions login` saves refreshable
# Codex credentials in the shared volume. Alternatively, uncomment a seed token
# here (no automatic refresh). Do not set an empty token.
# OPENAI_COMPAT_CODEX_TOKEN=replace-with-your-codex-access-token

# Host port only; the container always listens on port 8080.
PIG_PROXY_HOST_PORT=8080
PIG_PROXY_CAPTURE_CONVERSATION=true

# Optional generic OTLP trace export. Either endpoint enables export; leave both
# unset to disable. OTEL_EXPORTER_OTLP_ENDPOINT is a base URL (/v1/traces is
# appended); the signal-specific endpoint is the complete trace URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.tailnet.example:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector.tailnet.example:4318/v1/traces
# Initial supported protocol is HTTP protobuf; unsupported protocols are rejected.
# Trace-specific protocol overrides the generic value.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf

# Optional standard exporter headers. Comma-separated key=value pairs; avoid
# literal commas in values. Keep credentials secret and protect this .env file.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer TOKEN
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer TOKEN

# Direct Latitude uses the same standard settings, without a special mode:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://ingest.latitude.so/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer YOUR_API_KEY,X-Latitude-Project=your-project-slug

# Optional upstream overrides; leave unset rather than setting empty values.
# PIG_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex
# PIG_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
